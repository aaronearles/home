# Cloudflare DDNS Environment Configuration
# Copy this file and fill in values: cp env.sample master.env
# Reference: https://developers.cloudflare.com/api/

ZONEID=""          # Zone ID — https://developers.cloudflare.com/api/operations/zones-get
RECORDID=""        # DNS Record ID — https://developers.cloudflare.com/api/operations/dns-records-for-a-zone-list-dns-records
TOKEN=""           # API Token with Zone:DNS:Edit permission
NAME=""            # FQDN of the A record (e.g. master.earles.io)
NTFYTOPIC=""       # ntfy.sh topic for notifications
LOGPATH="/var/log/ddns.log"
