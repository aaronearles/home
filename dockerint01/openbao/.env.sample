# OpenBao stack (.env is gitignored; copy this file to .env)
# Nothing in here is a secret. All credentials live in OpenBao itself or in
# credentials/ (written by scripts/bootstrap.sh).

# --- openbao-backup ----------------------------------------------------------
# Where Raft snapshots go (NAS mount, like vaultwarden-backup).
BACKUP_DIR=/mnt/documents/openbao_backup
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# --- openbao-vaultwarden-sync ------------------------------------------------
# KV folders to mirror. Keep in step with policies/vaultwarden-sync.hcl.
SYNC_PREFIXES=infra/,agents/,apps/
SYNC_INTERVAL_SECONDS=300
# Trash Vaultwarden items whose secret was deleted in OpenBao.
SYNC_DELETE=true
# Log what would change without writing anything.
SYNC_DRY_RUN=false

# Vaultwarden URL. Must be HTTPS: the Bitwarden CLI refuses plain HTTP.
VW_URL=https://vaultwarden.internal.earles.io
# Only if Vaultwarden's certificate comes from a private CA (e.g. step-ca):
# mount the CA into the container and point Node at it.
# NODE_EXTRA_CA_CERTS=/credentials/ca.crt

# Target, option A (simplest): a folder in the sync account's own vault.
VW_FOLDER=OpenBao
# Target, option B (recommended): an organization collection shared with you.
# Get the ids from the web vault URL, or with `bw list organizations` / `bw list org-collections`.
# VW_ORGANIZATION_ID=
# VW_COLLECTION_ID=
