# Kong Credential-Brokering Demo
# Copy to .env and fill in values (generate keys with: openssl rand -hex 24)

# PostgreSQL
POSTGRES_DB=kong
POSTGRES_USER=kong
POSTGRES_PASSWORD=your_secure_db_password_here

# Master API key — the single key consumers present to Kong
KONG_MASTER_API_KEY=your_master_api_key_here

# Sidecar 1 credentials (Bearer token auth)
SIDECAR1_API_KEY=your_sidecar1_bearer_token_here

# Sidecar 2 credentials (HTTP Basic auth)
SIDECAR2_USER=sidecar2user
SIDECAR2_PASSWORD=your_sidecar2_password_here
