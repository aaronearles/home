# NetBox Application Configuration
# Copy to .env and fill in actual values

# Application
ALLOWED_HOSTS=netbox.internal.earles.io
TIME_ZONE=America/Chicago
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your_50_char_secret_key_here

# Superuser (created on first run if not exists)
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@earles.io
SUPERUSER_PASSWORD=your_admin_password
SUPERUSER_API_TOKEN=your_32_char_api_token_here

# Database — must match .db.env
DB_HOST=postgres
DB_PORT=5432
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=your_db_password

# Redis task queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Redis cache
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DATABASE=1
