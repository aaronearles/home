# Grok Bot web UI spike configuration template
# Copy this file to .env and update with your actual values

# Required once per browser as ?token=... (then kept in a cookie). Generate: openssl rand -hex 24
RELAY_TOKEN=change_me

# Unlocks the gnome-keyring that stores the app's encrypted sign-in tokens
KEYRING_PASSWORD=change_me

# Electron flags (same as the Xpra POC). RELAY_DEBUG=1 logs every relayed IPC channel name
APP_ARGS=--password-store=gnome-libsecret --disable-gpu --no-sandbox
RELAY_DEBUG=1

TZ=America/Denver
