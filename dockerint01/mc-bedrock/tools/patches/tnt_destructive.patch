--- a/scripts/tnt_logic.js
+++ b/scripts/tnt_logic.js
@@ -2,6 +2,8 @@ import { world, system, BlockPermutation } from "@minecraft/server";
 
 // gets what type of tnt it is
 function getIgnitedId(typeId) {
+    // God TNT's chunk-erase job hangs the scripting watchdog and shuts the server down.
+    if (typeId === "destructive:tnt_god") return null;
     if (typeId.startsWith("destructive:tnt_")) {
         return `${typeId}_ignited`;
     }
@@ -1297,6 +1299,7 @@ function v17GodChunkLooksLoaded(dim, cx, cz) {
     } catch { return false; }
 }
 function v17GodQueueChunk(dim, cx, cz) {
+    return; // god TNT disabled: never queue a chunk erase
     const key = v17GodChunkKey(dim, cx, cz);
     if (v17GodClearedChunks.has(key) || v17GodClearingChunks.has(key) || v17GodQueuedChunks.has(key)) return;
     if (!v17GodChunkLooksLoaded(dim, cx, cz)) return;
@@ -1505,6 +1508,7 @@ function v17GodVisualDetonations(loc, dim) {
     } catch { }
 }
 function v17GodDetonate(entity, loc, dim) {
+    return; // god TNT disabled: no tag, no explosion, no world erase
     try {
         v17GodVisualDetonations(loc, dim);
         v17SafeSound(dim, "ambient.weather.thunder", loc, { volume: 40, pitch: .25 });
@@ -1566,7 +1570,7 @@ system.runInterval(() => { v17GodPumpQueue(); }, 1);
 
 world.afterEvents.entitySpawn.subscribe((event) => {
     const e = event.entity; if (!e) return;
-    if (e.typeId === "destructive:tnt_god_ignited") v17GodCountdown(e);
+    if (e.typeId === "destructive:tnt_god_ignited") return;
     if (e.typeId === "destructive:tnt_firework_ignited") {
         system.runTimeout(() => {
             try { if (e.hasTag("v17_god_orbiter")) return; } catch { }
@@ -1729,7 +1733,6 @@ world.afterEvents.dataDrivenEntityTrigger.subscribe((event) => {
             v17SafeSound(dim, "random.explode", loc);
             break;
         case "destructive:god":
-            v17GodDetonate(entity, loc, dim);
             break;
         case "destructive:unbreakable": v17SafeSound(dim, "random.anvil_land", loc); v17Run(v17Unbreakable(loc, dim)); break;
     }
