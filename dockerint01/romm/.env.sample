# RomM Configuration
# Copy this file to .env and fill in your values

# Database connection (must match .db.env values)
DB_HOST=romm-db
DB_NAME=romm
DB_USER=romm-user
DB_PASSWD=your_db_password_here

# Required - generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# Timezone
TZ=America/Denver

# Library paths - set to your actual ROM library locations
ROMM_LIBRARY_PATH=/path/to/your/roms
ROMM_ASSETS_PATH=/path/to/your/assets

# Metadata providers (recommended - ScreenScraper is primary)
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=

# Additional metadata providers (optional)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=
MOBYGAMES_API_KEY=

# Free metadata providers (no key required)
HASHEOUS_API_ENABLED=true
PLAYMATCH_API_ENABLED=true
LAUNCHBOX_API_ENABLED=true

# OIDC/Authentik integration (optional)
# OIDC_ENABLED=true
# OIDC_PROVIDER_NAME=Authentik
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SERVER_APPLICATION_URL=https://authentik.internal.earles.io/application/o/romm/

# Scheduled tasks (optional)
# ENABLE_RESCAN_ON_FILESYSTEM_CHANGE=true
# ENABLE_SCHEDULED_RESCAN=false
# SCHEDULED_RESCAN_CRON=0 3 * * *
