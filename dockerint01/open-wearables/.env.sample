# Compose-level variables for docker-compose.yml (this file, not backend/config/.env).
# Copy to .env: cp .env.sample .env

# Postgres credentials used to build the svix-server DSN.
# Must match DB_USER / DB_PASSWORD in backend/config/.env.
DB_USER=open-wearables
DB_PASSWORD=change_me

# Public, browser-facing URL of the backend API (baked into the frontend at build time).
# Point this at the Traefik hostname for the open-wearables-api router below.
VITE_API_URL=https://open-wearables-api.internal.earles.io
