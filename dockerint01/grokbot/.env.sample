# Grok Bot (Xpra) configuration template
# Copy this file to .env and update with your actual values

# Filename of the official installer placed in ./installer/ (.deb or .AppImage, matching the host arch)
GROKBOT_INSTALLER=GrokBot-x.y.z-amd64.deb

# Xpra session password (second layer behind Authentik; stops other containers on the traefik network)
# Generate: openssl rand -base64 24
XPRA_PASSWORD=change_me

# Unlocks the gnome-keyring that stores the app's encrypted sign-in tokens
# Changing it after first run makes the stored tokens unreadable (you will need to sign in again)
KEYRING_PASSWORD=change_me

# Extra flags for the Electron app (launch flags only, the app itself is not modified)
#   --password-store=gnome-libsecret  use the keyring even though there is no desktop environment
#   --disable-gpu                     no GPU in Xvfb; avoids GPU-process crash loops
#   --no-sandbox                      Docker's default seccomp blocks Chromium's namespace sandbox;
#                                     remove this if you run with a seccomp profile that allows it
APP_ARGS=--password-store=gnome-libsecret --disable-gpu --no-sandbox

TZ=America/Denver
