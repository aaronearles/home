# Firecrawl Configuration
# Copy this file to .env and update with your actual values

# API Server
HOST=0.0.0.0
INTERNAL_PORT=3002
ENV=local

# Internal Service URLs (pre-configured for this stack)
REDIS_URL=redis://firecrawl-redis:6379
REDIS_RATE_LIMIT_URL=redis://firecrawl-redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://firecrawl-playwright:3000/scrape
NUQ_RABBITMQ_URL=amqp://firecrawl-rabbitmq:5672

# PostgreSQL
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=firecrawl
POSTGRES_HOST=firecrawl-postgres
POSTGRES_PORT=5432

# Authentication
# Set to true to require API keys (requires Supabase configuration below)
USE_DB_AUTHENTICATION=false
# Required: protects the Bull Queue management UI
BULL_AUTH_KEY=your_strong_bull_auth_key_here
# Optional: default API key when USE_DB_AUTHENTICATION=false
TEST_API_KEY=

# Worker Configuration
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
HARNESS_STARTUP_TIMEOUT_MS=60000
EXTRACT_WORKER_PORT=3004
WORKER_PORT=3005

# LLM Configuration (optional - for AI-powered extraction)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=
AUTUMN_SECRET_KEY=

# Proxy Configuration (optional)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Search Integration (optional - requires SearXNG instance)
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# Supabase (optional - required when USE_DB_AUTHENTICATION=true)
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=

# Notifications (optional)
SLACK_WEBHOOK_URL=
SELF_HOSTED_WEBHOOK_URL=

# Browser Configuration
BLOCK_MEDIA=false
ALLOW_LOCAL_WEBHOOKS=false

# Logging
LOGGING_LEVEL=info
